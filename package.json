{
  "name": "azure-foundry-provider",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "description": "AI SDK provider for Azure AI Foundry and Azure OpenAI with intelligent endpoint routing, adaptive throttling, and operation-mismatch fallback recovery",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:artifact": "bun build --outdir=dist src/index.ts && bun run test/verify-artifact.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.96",
    "@ai-sdk/openai-compatible": "2.0.67",
    "@ai-sdk/provider": "3.0.15",
    "@ai-sdk/provider-utils": "4.0.45",
    "@azure/identity": "4.14.1",
    "ai": "7.0.159"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.9.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
